#!/usr/bin/env bash
#
# openloop_cc_docker — the default cc_docker agent. Dispatches to the provider
# you choose. Edit PROVIDER below, or override per-run with:
#     OPENLOOP_PROVIDER=z openloop_cc_docker ...
#
# Valid providers:
#   "a"  anthropic subscription/key   (-> openloop_cc_docker-a)
#   "z"  z.ai                         (-> openloop_cc_docker-z)
#
# Default: "a".

_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PROVIDER="${OPENLOOP_PROVIDER:-z}"

exec "$_dir/openloop_cc_docker-$PROVIDER" "$@"
