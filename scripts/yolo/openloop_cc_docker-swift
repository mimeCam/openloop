#!/usr/bin/env bash
#
# openloop_cc_docker-swift — swift image, provider of your choice.
#
# Pick the default provider by editing PROVIDER below, or override per-run with:
#     OPENLOOP_PROVIDER=z openloop_cc_docker-swift ...
#
# Valid providers:
#   "a"  anthropic subscription/key   (-> openloop_cc_docker-swift-a)
#   "z"  z.ai                         (-> openloop_cc_docker-swift-z)
#
# Default: "a".

_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PROVIDER="${OPENLOOP_PROVIDER:-z}"

exec "$_dir/openloop_cc_docker-swift-$PROVIDER" "$@"
