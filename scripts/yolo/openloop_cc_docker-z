#!/usr/bin/env bash
#
# openloop_cc_docker-z — z.ai provider, default image.
# Config (API_KEY, API_ENDPOINT, model overrides) is read from
# openloop_cc_docker-z.env next to this script. See scripts/yolo/README.md.

IMAGE="yolo_devcontainer"
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$_dir/load-env-file"

"$_dir/openloop_cc_docker-base" "$IMAGE" "-z" "$@"
