#!/usr/bin/env bash
#
# y-z - shared base for yolo-z scripts (yz, ywz) using API_KEY + API_ENDPOINT
#

current_dir=$(pwd)
if [[ "$current_dir" != "$HOME"/* && "$current_dir" != /private/var/folders/* && "$current_dir" != /var/folders/* ]]; then
    echo "OOPS: Current directory must be at least 1 level deep inside HOME directory or inside a system's temp folder."
    echo "Current directory: $current_dir"
    echo "Home directory: $HOME"
    echo "Exiting now. Execution in root HOME dir is not allowed."

    exit 2
fi

SYSTEM_PROMPT='You (LLM agent) and me are in a pair-programming session together.

We align to these rules for our pair-programming environment:
- do not add comments to a newly produced code - we are professionals and understand generated code 100%.
- do not remove existing comments that were left previously as these may be needed later to re-enable those features in the future.
- no function can be longer than 10 lines, refactor otherwise. Leverage functional programming best practices

Think a lot before writting an implementation. Imagine a system as if it was drawn on a paper in plain diagram: improve this diagram, verify and approve the diagram first and only then proceed to implementing it in code.

Be pragmatic and concise.'


IMAGE="${IMAGE:-yolo_devcontainer}"

# y-z reads its config (API_KEY, API_ENDPOINT, model overrides) from y-z.env
# next to this file via load-env-file. NOTE: this file is sourced (by yz,
# ywz, ...) — inside it BASH_SOURCE[0] is y-z itself, and inside
# load-env-file BASH_SOURCE[1] is then y-z, so y-z.env resolution works
# either way.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/load-env-file"

SUFFIX="-z"

CLAUDE_JSON="$HOME/.claude${SUFFIX}.json"
CLAUDE_JSON_BK="$HOME/.claude${SUFFIX}.json.backup"
CLAUDE_DIR="$HOME/.claude${SUFFIX}"

mkdir -p "$CLAUDE_DIR"
[ ! -f "$CLAUDE_JSON" ] && echo '{}' > "$CLAUDE_JSON"
[ ! -f "$CLAUDE_JSON_BK" ] && echo '{}' > "$CLAUDE_JSON_BK"

MODEL_ENV_FLAGS=()
[ -n "$ANTHROPIC_DEFAULT_OPUS_MODEL" ] && MODEL_ENV_FLAGS+=(-e "ANTHROPIC_DEFAULT_OPUS_MODEL=$ANTHROPIC_DEFAULT_OPUS_MODEL")
[ -n "$ANTHROPIC_DEFAULT_SONNET_MODEL" ] && MODEL_ENV_FLAGS+=(-e "ANTHROPIC_DEFAULT_SONNET_MODEL=$ANTHROPIC_DEFAULT_SONNET_MODEL")
[ -n "$ANTHROPIC_DEFAULT_HAIKU_MODEL" ] && MODEL_ENV_FLAGS+=(-e "ANTHROPIC_DEFAULT_HAIKU_MODEL=$ANTHROPIC_DEFAULT_HAIKU_MODEL")
[ -n "$CLAUDE_CODE_SUBAGENT_MODEL" ] && MODEL_ENV_FLAGS+=(-e "CLAUDE_CODE_SUBAGENT_MODEL=$CLAUDE_CODE_SUBAGENT_MODEL")

CLAUDE_CMD="claude --model sonnet --no-chrome --dangerously-skip-permissions --system-prompt \"\$SYSTEM_PROMPT\""
if [ -n "$PROMPT" ]; then
	CLAUDE_CMD="$CLAUDE_CMD -p \"\$PROMPT\""
fi

docker run --rm -it \
    --init --pids-limit=500 \
    -p 53714:53714 \
    -v /etc/localtime:/etc/localtime:ro \
	-e COLORTERM=truecolor \
	-e ANTHROPIC_LOG=error \
	-e CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
	-e CLAUDE_CODE_ATTRIBUTION_HEADER=0 \
	-e "ANTHROPIC_BASE_URL=${API_ENDPOINT}" \
	-e "ANTHROPIC_AUTH_TOKEN=${API_KEY}" \
	-e BASH_DEFAULT_TIMEOUT_MS=10000 \
    -e BASH_MAX_TIMEOUT_MS=15000 \
	"${MODEL_ENV_FLAGS[@]}" \
	-e "PROMPT=${PROMPT}" \
	-e "SYSTEM_PROMPT=${SYSTEM_PROMPT}" \
	-v "$CLAUDE_DIR:/home/node/.claude" \
	-v "$CLAUDE_JSON:/home/node/.claude.json" \
	-v "$CLAUDE_JSON_BK:/home/node/.claude.json.backup" \
	-v "$PWD:$PWD" \
	-w "$PWD" \
	--name "$CONTAINER_NAME" \
	$IMAGE bash -c ". /home/node/.local/bin/env && $CLAUDE_CMD"
